# ──────────────────────────────────────────────────────────────────────────────
# EZ Marketing Agency — Media Operations System
# Environment Variables — TEMPLATE
#
# Copy this file to .env and fill in your values.
# .env is gitignored. NEVER commit real keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (PostgreSQL backend) ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# The publishable/anon key is safe to ship in the browser bundle — it is
# protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ── OpenAI (AI Studio — SERVER-SIDE ONLY on Vercel) ───────────────────────────
# Used by the Vercel serverless function /api/ai/generate
# NEVER prefix with VITE_ — that would expose it to the browser
OPENAI_API_KEY=sk-your-openai-api-key

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Set these in Vercel Dashboard → Environment Variables for deployed builds.

# Use real Supabase auth. Required — there is no demo credential fallback.
VITE_ENABLE_REAL_AUTH=true

# Enable AI Studio live generation (set to true when OPENAI_API_KEY is set)
VITE_ENABLE_AI=false

# Seed/display data for dashboards. Does NOT affect authentication.
VITE_DEMO_MODE=false
