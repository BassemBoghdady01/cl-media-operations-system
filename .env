# ──────────────────────────────────────────────────────────────────────────────
# EZ Marketing Agency — Media Operations System
# Environment Variables
#
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (PostgreSQL backend) ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://ytgpailppajqrgtfcunz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_BGsRvcinaq_V0GsMz1y7NQ_mkrVDusP

# ── OpenAI (AI Studio — SERVER-SIDE ONLY on Vercel) ───────────────────────────
# This key is used by the Vercel serverless function /api/ai/generate
# NEVER prefix with VITE_ — that would expose it to the browser
OPENAI_API_KEY=sk-your-openai-api-key

# ── App URL ───────────────────────────────────────────────────────────────────
VITE_APP_URL=https://ytgpailppajqrgtfcunz.supabase.co

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Set these in Vercel Dashboard → Environment Variables

# Use real Supabase auth (set to true when Supabase is configured)
VITE_ENABLE_REAL_AUTH=true

# Enable AI Studio live generation (set to true when OPENAI_API_KEY is set)
VITE_ENABLE_AI=false
VITE_APP_URL=http://localhost:5173
# Demo/seed mode (set to false for production)
# When false: all data comes from Supabase, no seed data is shown
VITE_DEMO_MODE=false
